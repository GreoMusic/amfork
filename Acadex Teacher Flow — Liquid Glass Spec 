16) Data Models (client-side shape)

// Class
Class {
  id: string;
  name: string;
  description?: string;
  yearStart?: number; // e.g., 2025
  yearEnd?: number;   // e.g., 2026
  totalStudents: number;
  totalAssignments: number;
  averageGrade?: string; // e.g., "B+"
}

// Assignment
Assignment {
  id: string;
  classId: string;
  title: string;
  details?: string;
  rubric?: string; // serialized text
  lookouts: string[]; // fixed ids from step4
  gradeLevel: 'K-6'|'7'|'8'|'9'|'10'|'11'|'12'|'College';
  style: 'critical'|'normal'|'flexible';
  completion: { completed: number; total: number; };
  averageGrade?: string;
}

// Submission
Submission {
  id: string;
  assignmentId: string;
  title: string;
  origin: 'student'|'teacher';
  completed: boolean;
  grade?: string; // A+..F
  files: { paperUrl: string; gradeOutputUrl?: string };
  createdAt: string;
  gradedAt?: string;
}

// Student
Student {
  id: string;
  classId: string;
  name: string;
  email?: string;
  studentId?: string;
  status: 'active'|'inactive';
  lastActive?: string;
}

// User/Plan
User {
  id: string; name: string; email: string; avatarUrl?: string;
  plan: 'free'|'bronze'|'silver'|'gold'|'school';
  usage: { submissions: number; assessments: number };
  features: { studentSide: boolean; roster: boolean; cuttingEdgeAI: boolean };
}


